<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- ============================================== -->
    <!-- STEP 1: FACE VERIFICATION (Camera Preview)     -->
    <!-- ============================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutStepFace"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#660F172A" />

        <!-- Header -->
        <LinearLayout
            android:id="@+id/faceHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="36dp"
            android:paddingHorizontal="24dp"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VERIFYING IDENTITY"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvFaceSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Position your face inside the frame"
                android:textSize="13sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <!-- Face Alignment Guide Ring -->
        <View
            android:id="@+id/faceGuide"
            android:layout_width="280dp"
            android:layout_height="350dp"
            android:background="@drawable/face_guide_ring"
            app:layout_constraintTop_toBottomOf="@id/faceHeader"
            app:layout_constraintBottom_toTopOf="@id/faceBottomBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Failure Banner (Hidden by default) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFaceFailure"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#FEF2F2"
            app:strokeColor="#F87171"
            app:strokeWidth="1dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/faceGuide"
            app:layout_constraintBottom_toTopOf="@id/faceBottomBar">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">
                <TextView
                    android:id="@+id/tvFaceFailureTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FACE VERIFICATION FAILED"
                    android:textColor="#DC2626"
                    android:textStyle="bold"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tvFaceFailureMsg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="The registered employee face could not be verified."
                    android:textColor="#7F1D1D"
                    android:textSize="12sp"
                    android:gravity="center" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetryFace"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="TRY AGAIN"
                    android:textColor="#DC2626"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom Status Bar -->
        <LinearLayout
            android:id="@+id/faceBottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center"
            android:background="#CC0F172A"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <ProgressBar
                    android:id="@+id/pbFaceStatus"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminateTint="#2563EB" />
                <TextView
                    android:id="@+id/tvFaceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Detecting face..."
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptureFaceVerify"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Verify Face"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                android:backgroundTint="#2563EB" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ============================================== -->
    <!-- STEP 2 & 3: LOCATION & GEOFENCE VERIFICATION   -->
    <!-- ============================================== -->
    <ScrollView
        android:id="@+id/layoutStepLocation"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8FAFC"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VERIFYING LOCATION"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Confirming GPS coordinates against work-site geofence"
                android:textSize="13sp"
                android:textColor="#64748B" />

            <!-- Live Location Radar / Map Container -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="14dp"
                app:strokeColor="#CBD5E1"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Visual Geofence Circle representation -->
                    <View
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="center"
                        android:background="@drawable/avatar_bg"
                        android:alpha="0.25" />

                    <View
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center"
                        android:background="@drawable/circle_success"
                        android:alpha="0.3" />

                    <!-- Site Center Pin -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_dialog_map"
                        app:tint="#2563EB" />

                    <!-- Employee Pin -->
                    <ImageView
                        android:id="@+id/ivEmployeePin"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:translationX="20dp"
                        android:translationY="-15dp"
                        android:src="@android:drawable/presence_online" />

                    <!-- Map Overlay Badges -->
                    <TextView
                        android:id="@+id/tvMapGeofenceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="#CC0F172A"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="GEOFENCE BOUNDARY • 150m"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMapStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:background="#DCFCE7"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="INSIDE WORK SITE ✓"
                        android:textColor="#16A34A"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Metrics Card (Current vs Work Site) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Current Location"
                                android:textSize="11sp"
                                android:textColor="#64748B" />
                            <TextView
                                android:id="@+id/tvCurrentCoordinates"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="21.1460, 79.0884"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:textColor="#0F172A" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Work Site Location"
                                android:textSize="11sp"
                                android:textColor="#64748B" />
                            <TextView
                                android:id="@+id/tvSiteCoordinates"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="21.1458, 79.0882"
                                android:textStyle="bold"
                                android:textSize="13sp"
                                android:textColor="#0F172A" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#F1F5F9"
                        android:layout_marginVertical="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Calculated Distance"
                                android:textSize="11sp"
                                android:textColor="#64748B" />
                            <TextView
                                android:id="@+id/tvCalcDistance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="42 m"
                                android:textStyle="bold"
                                android:textSize="15sp"
                                android:textColor="#16A34A" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Allowed Radius"
                                android:textSize="11sp"
                                android:textColor="#64748B" />
                            <TextView
                                android:id="@+id/tvAllowedRadius"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="150 m"
                                android:textStyle="bold"
                                android:textSize="15sp"
                                android:textColor="#2563EB" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:id="@+id/tvAltitudeComparison"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Altitude: 311 m (Site: 312 m)"
                            android:textSize="12sp"
                            android:textColor="#64748B" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Location Failure Card (if outside) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLocationFailure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="#FEF2F2"
                app:strokeColor="#F87171"
                app:strokeWidth="1dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LOCATION VERIFICATION FAILED"
                        android:textColor="#DC2626"
                        android:textStyle="bold"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvLocFailureDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="You are outside the assigned work site.\nDistance: 426 m | Allowed: 150 m"
                        android:textColor="#7F1D1D"
                        android:textSize="12sp"
                        android:gravity="center" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetryLocation"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="TRY AGAIN"
                        android:textColor="#DC2626"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STEP 4: VERIFICATION SUMMARY -->
            <TextView
                android:id="@+id/tvSummaryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="VERIFICATION SUMMARY"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:letterSpacing="0.05" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSummaryDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="12dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Identity"
                            android:textSize="13sp"
                            android:textColor="#64748B" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Verified"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#16A34A" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Face"
                            android:textSize="13sp"
                            android:textColor="#64748B" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Matched"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#16A34A" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Location"
                            android:textSize="13sp"
                            android:textColor="#64748B" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Verified"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#16A34A" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Work Site"
                            android:textSize="13sp"
                            android:textColor="#64748B" />
                        <TextView
                            android:id="@+id/tvSummarySiteName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Matched (Apex Tower)"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#16A34A" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Geofence"
                            android:textSize="13sp"
                            android:textColor="#64748B" />
                        <TextView
                            android:id="@+id/tvSummaryGeofence"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Inside permitted area"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#16A34A" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="GPS Accuracy"
                            android:textSize="13sp"
                            android:textColor="#64748B" />
                        <TextView
                            android:id="@+id/tvSummaryAccuracy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8.0 m"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#0F172A" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordAttendance"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"
                android:text="RECORD ATTENDANCE..."
                android:textStyle="bold"
                android:textSize="15sp"
                app:cornerRadius="10dp"
                android:backgroundTint="#2563EB" />

        </LinearLayout>
    </ScrollView>

    <!-- ============================================== -->
    <!-- STEP 5: SUCCESS SCREEN                         -->
    <!-- ============================================== -->
    <LinearLayout
        android:id="@+id/layoutStepSuccess"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <!-- Checkmark Circle -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/circle_success">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✓"
                android:textColor="#16A34A"
                android:textSize="44sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="PUNCH IN SUCCESSFUL"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/tvSuccessTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="08:42 AM"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2563EB" />

        <TextView
            android:id="@+id/tvSuccessSite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Apex Tower Construction Site"
            android:textSize="14sp"
            android:textColor="#64748B" />

        <!-- Verification Checklist Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="12dp"
            app:strokeColor="#DCFCE7"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="#F0FDF4">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verification Summary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#166534"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Face Verified ✓"
                    android:textColor="#16A34A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Location Verified ✓"
                    android:textColor="#16A34A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Work Site Verified ✓"
                    android:textColor="#16A34A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Coordinates recorded ✓"
                    android:textColor="#16A34A"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewAttendance"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:text="VIEW ATTENDANCE"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            android:backgroundTint="#2563EB" />
    </LinearLayout>

</FrameLayout>
