<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Camera Preview ViewFinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/enrollViewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dark Overlay with Oval Cutout Guide -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#660F172A" />

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="36dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REGISTER EMPLOYEE FACE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvEnrollSubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Position your face inside the frame"
            android:textSize="13sp"
            android:textColor="#94A3B8" />
    </LinearLayout>

    <!-- Face Alignment Frame (Oval ring) -->
    <FrameLayout
        android:id="@+id/faceOvalFrame"
        android:layout_width="280dp"
        android:layout_height="360dp"
        android:background="@drawable/face_guide_ring"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomControlLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Scanning Pulse Line -->
        <View
            android:id="@+id/scanLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#2563EB"
            android:layout_gravity="center" />
    </FrameLayout>

    <!-- Status Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEnrollStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="#CC1E293B"
        app:strokeColor="#334155"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/bottomControlLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <ProgressBar
                android:id="@+id/pbEnrollLoading"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateTint="#2563EB" />

            <TextView
                android:id="@+id/tvEnrollStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Preparing camera..."
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/bottomControlLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCaptureFace"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Capture &amp; Enroll Face"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="#2563EB" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelEnroll"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cancel"
            android:textColor="#94A3B8" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
