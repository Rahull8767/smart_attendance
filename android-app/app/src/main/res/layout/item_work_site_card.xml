<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardElevation="1dp"
    app:cardCornerRadius="12dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSiteCardName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Apex Tower Construction Site"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0F172A" />

            <TextView
                android:id="@+id/tvSiteCardStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DCFCE7"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="ACTIVE"
                android:textColor="#16A34A"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSiteCardAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nagpur, Maharashtra, India"
            android:textSize="13sp"
            android:textColor="#64748B" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginVertical="12dp" />

        <!-- Coordinates & Geofence Details -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Latitude"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />
                <TextView
                    android:id="@+id/tvSiteCardLat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="21.1458° N"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#334155" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Longitude"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />
                <TextView
                    android:id="@+id/tvSiteCardLon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="79.0882° E"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#334155" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Altitude"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />
                <TextView
                    android:id="@+id/tvSiteCardAlt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="312 m"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#334155" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allowed Radius"
                    android:textSize="11sp"
                    android:textColor="#94A3B8" />
                <TextView
                    android:id="@+id/tvSiteCardRadius"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="150 m"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#2563EB" />
            </LinearLayout>
        </GridLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
