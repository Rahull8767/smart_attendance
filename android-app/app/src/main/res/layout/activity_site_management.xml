<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/siteHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBackSites"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#0F172A" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Work Sites"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddSite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Site"
            android:textStyle="bold"
            android:textSize="13sp"
            android:backgroundTint="#2563EB"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <View
        android:id="@+id/siteDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0"
        app:layout_constraintTop_toBottomOf="@id/siteHeaderLayout" />

    <!-- Subtitle / Info Banner -->
    <LinearLayout
        android:id="@+id/bannerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:background="#EFF6FF"
        app:layout_constraintTop_toBottomOf="@id/siteDivider">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 GPS geofenced work zones for field attendance"
            android:textColor="#1D4ED8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Work Sites List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSites"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/bannerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCeo" />

    <TextView
        android:id="@+id/tvEmptySites"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No work sites registered"
        android:textColor="#64748B"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/bannerLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomNavCeo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavCeo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="8dp"
        app:itemIconTint="#2563EB"
        app:itemTextColor="#0F172A"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_ceo" />

</androidx.constraintlayout.widget.ConstraintLayout>
