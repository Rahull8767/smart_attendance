<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="24dp">

    <!-- Avatar Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/circle_blue_light">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="R"
                android:textColor="#2563EB"
                android:textSize="26sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Rahul Sharma"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="rahul.sharma@apex.com"
            android:textColor="#64748B"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginBottom="16dp" />

    <!-- Info rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Employee ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Employee ID"
                android:textColor="#64748B"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvProfileEmpId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMP-1024"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Department -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Department"
                android:textColor="#64748B"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvProfileDept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Field Operations"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Designation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Designation"
                android:textColor="#64748B"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvProfileDesignation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Site Supervisor"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Assigned Site -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Assigned Work Site"
                android:textColor="#64748B"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/tvProfileSite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apex Tower Construction Site"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Biometrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Biometric Status"
                android:textColor="#64748B"
                android:textSize="13sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Face Enrolled ✓"
                android:textColor="#16A34A"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginBottom="16dp" />

    <!-- Actions -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogoutEmployee"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="LOGOUT"
        android:textColor="#DC2626"
        android:textStyle="bold"
        android:textSize="14sp"
        app:strokeColor="#FCA5A5"
        app:strokeWidth="1dp"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:cornerRadius="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseProfile"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="Close"
        android:textColor="#64748B"
        style="@style/Widget.Material3.Button.TextButton" />

</LinearLayout>
